# Copy this file to .env and fill in real values. Never commit .env.

PORT=5001

# Local MongoDB. If your password contains "@", write it as "%40" in the URI.
MONGO_URI=mongodb://pawshare:YOUR_DB_PASSWORD@localhost:27017/pawshare?authSource=pawshare

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend URL (allowed by CORS and socket.io)
CLIENT_URL=http://localhost:5173

# Optional SMTP for emails. Leave blank to print emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PawShare <no-reply@pawshare.local>"
